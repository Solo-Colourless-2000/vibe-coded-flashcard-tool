{
  "name": "recall-local-code-study-tool",
  "version": "0.2.1",
  "private": true,
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=22.13.0 <25"
  },
  "scripts": {
    "dev": "vinext dev --hostname 127.0.0.1 --port 3000",
    "build": "vinext build",
    "start": "node start-local.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern release",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "check": "npm run test && npm run typecheck && npm run lint && npm run manual:verify",
    "manual:build": "node docs/manual-source/generate_manual_html.mjs",
    "manual:verify": "node docs/manual-source/verify_manual_html.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "notices": "node scripts/generate-third-party-notices.mjs",
    "release:prepare": "node scripts/prepare-source-release.mjs",
    "release:verify": "node scripts/verify-source-release.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@lezer/highlight": "1.2.3",
    "codemirror": "6.0.2",
    "lucide-react": "1.34.0",
    "next": "16.3.2",
    "papaparse": "5.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "9.3.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "5.20260823.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "sharp@0.35.2": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20260820.1": true
  }
}
